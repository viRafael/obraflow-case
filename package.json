{
  "name": "obraflow-case",
  "private": true,
  "description": "Desafio ObraFlow — Dokimos: pedidos de compra com aprovação por alçada",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @obraflow/api start:dev",
    "test:api": "pnpm --filter @obraflow/api test",
    "db:migrate": "pnpm --filter @obraflow/api db:migrate",
    "db:seed": "pnpm --filter @obraflow/api db:seed"
  }
}
